{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xcaliber",
  "version": "1.1.0",
  "identifier": "dev.xcaliber.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xcaliber",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "category": "DeveloperTool",
    "shortDescription": "Local Kimi K3 runtime controller"
  }
}
