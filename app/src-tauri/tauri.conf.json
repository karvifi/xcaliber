{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xcaliber",
  "version": "1.3.0",
  "identifier": "dev.xcaliber.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xcaliber",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local Kimi K3 runtime controller",
    "longDescription": "Measure the host, choose an honest local execution mode, manage Kimi K3 model files, and connect to a loopback OpenAI-compatible runtime.",
    "copyright": "Copyright © 2026 Xcaliber contributors"
  }
}
